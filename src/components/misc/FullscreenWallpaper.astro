---
import { siteConfig } from "../../config";
import type { FullscreenWallpaperConfig } from "../../types/config";

interface Props {
	config: FullscreenWallpaperConfig;
	className?: string;
}

const { config, className } = Astro.props;

// 获取当前设备类型的图片源
const getImageSources = async () => {
	const srcConfig = config.src;

	// API 图片逻辑
	if (siteConfig.banner.imageApi?.enable && siteConfig.banner.imageApi?.url) {
		try {
			const response = await fetch(siteConfig.banner.imageApi.url);
			const text = await response.text();
			const apiImages = text.split("\n").filter((line) => line.trim());
			if (apiImages.length > 0) {
				return { desktop: apiImages, mobile: apiImages };
			}
		} catch (error) {
			console.warn("Failed to fetch images from API:", error);
		}
	}

	const toArray = (src: string | string[] | undefined): string[] => 
		Array.isArray(src) ? src : (typeof src === "string" ? [src] : []);

	if (typeof srcConfig === "object" && srcConfig !== null && !Array.isArray(srcConfig)) {
		const desktop = toArray(srcConfig.desktop);
		const mobile = toArray(srcConfig.mobile);
		return {
			desktop: desktop.length > 0 ? desktop : mobile,
			mobile: mobile.length > 0 ? mobile : desktop,
		};
	}

	// 如果是字符串或字符串数组，同时用于桌面端和移动端
	const allImages = toArray(srcConfig as string | string[]);
	return { desktop: allImages, mobile: allImages };
};

const imageSources = await getImageSources();
const hasDesktopImages = imageSources.desktop.length > 0;
const hasMobileImages = imageSources.mobile.length > 0;

if (!hasDesktopImages && !hasMobileImages) {return null;}

// 轮播配置
const isCarouselEnabled = config.carousel?.enable && 
	(imageSources.desktop.length > 1 || imageSources.mobile.length > 1);
const carouselInterval = config.carousel?.interval || 5;
const carouselFadeDuration = 420;

// 样式配置
const position = config.position || "center";
const zIndex = config.zIndex || -1;
const opacity = config.opacity || 0.8;
const blurAmount = config.blur || 0;
const positionClass = (() => {
	switch (position) {
		case "top": return "object-top";
		case "bottom": return "object-bottom";
		default: return "object-center";
	}
})();

const renderGroups = [
	{
		key: "desktop",
		images: imageSources.desktop,
		containerClass: "hidden md:block",
		hasImages: hasDesktopImages,
	},
	{
		key: "mobile",
		images: imageSources.mobile,
		containerClass: "block md:hidden",
		hasImages: hasMobileImages,
	},
];
---

<div
	class:list={[
		"fixed inset-0 w-full h-full overflow-hidden pointer-events-none",
		className,
	]}
	style={`z-index: ${zIndex}; opacity: ${opacity}; transform: translateZ(0);`}
	data-fullscreen-wallpaper
>
	{isCarouselEnabled ? (
		renderGroups.map(
			(group) =>
				group.hasImages && (
					<div
						class={`${group.containerClass} w-full h-full relative`}
						data-wallpaper-group={group.key}
					>
						{group.images.map((src, index) => (
							<template data-wallpaper-frame>
								<img
									src={src}
									alt={`${group.key} wallpaper ${index + 1}`}
									class={`absolute inset-0 w-full h-full object-cover transition-opacity ${positionClass}`}
									data-carousel-item={index}
									style={`${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ""} opacity: ${index === 0 ? 1 : 0}; transition-duration: ${carouselFadeDuration}ms; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);`}
									decoding="async"
									loading={index === 0 ? "eager" : "lazy"}
									fetchpriority={index === 0 ? "high" : undefined}
								/>
							</template>
						))}
					</div>
				),
		)
	) : (
		<div id="wallpaper-single-container" class="w-full h-full relative"></div>
	)}
</div>

<script
	is:inline
	data-swup-ignore-script
	define:vars={{
		carouselInterval,
		isCarouselEnabled: Boolean(isCarouselEnabled),
		desktopImages: imageSources.desktop,
		mobileImages: imageSources.mobile,
		positionClass,
		blurAmount,
		carouselFadeDuration,
	}}
>
	(function initFullscreenWallpaper() {
		const root = document.querySelector("[data-fullscreen-wallpaper]");
		if (!root) return;

		let cleanupCarousel = null;
		let activeMode = null;
		let activeGroupKey = null;

		const getMode = () =>
			localStorage.getItem("wallpaperMode") || "banner";
		const getActiveGroupKey = () =>
			window.matchMedia("(min-width: 768px)").matches
				? "desktop"
				: "mobile";

		function getRandomImage(images, storageKey) {
			if (!images.length) return null;
			if (images.length === 1) return images[0];

			const lastIndex = sessionStorage.getItem(storageKey);
			let newIndex;
			do {
				newIndex = Math.floor(Math.random() * images.length);
			} while (newIndex === Number.parseInt(lastIndex || "-1", 10));
			sessionStorage.setItem(storageKey, newIndex.toString());
			return images[newIndex];
		}

		function stopCarousel() {
			if (cleanupCarousel) {
				cleanupCarousel();
				cleanupCarousel = null;
			}
		}

		function mountSingleImage(groupKey) {
			const container = root.querySelector("#wallpaper-single-container");
			if (!container) return;
			container.querySelectorAll(":scope > div").forEach((wrapper) =>
				wrapper.remove(),
			);

			const images = groupKey === "desktop" ? desktopImages : mobileImages;
			const src = getRandomImage(images, `wallpaper_${groupKey}_index`);
			if (!src) return;

			const wrapper = document.createElement("div");
			wrapper.className =
				groupKey === "desktop"
					? "hidden md:block w-full h-full relative"
					: "block md:hidden w-full h-full relative";

			const image = document.createElement("img");
			image.src = src;
			image.alt = `${groupKey} wallpaper`;
			image.className =
				`absolute inset-0 w-full h-full object-cover transition-opacity ${positionClass}`;
			image.style.cssText =
				`${blurAmount > 0 ? `filter: blur(${blurAmount}px);` : ""} opacity: 1; transition-duration: ${carouselFadeDuration}ms; transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);`;
			image.decoding = "async";
			image.loading = "eager";
			image.fetchPriority = "high";
			wrapper.appendChild(image);
			container.appendChild(wrapper);
		}

		function startCarousel(groupKey) {
			stopCarousel();
			const group = root.querySelector(
				`[data-wallpaper-group="${groupKey}"]`,
			);
			if (!group) return;

			const items = group.querySelectorAll("[data-carousel-item]");
			if (!items.length) return;
			const savedIndex = Number.parseInt(
				sessionStorage.getItem("mizuki_wallpaper_index") || "0",
				10,
			);
			let currentIndex =
				savedIndex >= 0 && savedIndex < items.length ? savedIndex : 0;
			items.forEach((item, index) => {
				item.style.opacity = index === currentIndex ? "1" : "0";
			});

			const updateFrameHints = (activeIndex, nextIndex) => {
				// Keep compositor promotion limited to the two frames that can fade.
				items.forEach((item, index) => {
					item.style.willChange =
						index === activeIndex || index === nextIndex ? "opacity" : "auto";
				});
			};
			updateFrameHints(
				currentIndex,
				items.length > 1 ? (currentIndex + 1) % items.length : currentIndex,
			);

			let timer = null;
			let scrollResumeTimer = null;
			let frameRequest = null;
			let isScrollPaused = false;
			const stop = () => {
				if (timer) {
					clearInterval(timer);
					timer = null;
				}
				if (frameRequest !== null) {
					cancelAnimationFrame(frameRequest);
					frameRequest = null;
				}
			};
			const start = () => {
				if (items.length <= 1 || timer || document.hidden || isScrollPaused) return;
				timer = setInterval(() => {
					const previousIndex = currentIndex;
					const nextIndex = (currentIndex + 1) % items.length;
					updateFrameHints(previousIndex, nextIndex);
					frameRequest = requestAnimationFrame(() => {
						items[previousIndex].style.opacity = "0";
						items[nextIndex].style.opacity = "1";
						currentIndex = nextIndex;
						sessionStorage.setItem(
							"mizuki_wallpaper_index",
							currentIndex.toString(),
						);
						frameRequest = null;
					});
				}, carouselInterval * 1000);
			};
			const handleScroll = () => {
				// Do not compete with scroll and navbar work on the main thread.
				isScrollPaused = true;
				stop();
				if (scrollResumeTimer !== null) clearTimeout(scrollResumeTimer);
				scrollResumeTimer = window.setTimeout(() => {
					scrollResumeTimer = null;
					isScrollPaused = false;
					start();
				}, 180);
			};
			const handleVisibilityChange = () => {
				if (document.hidden) stop();
				else if (!isScrollPaused) start();
			};
			document.addEventListener("visibilitychange", handleVisibilityChange);
			window.addEventListener("scroll", handleScroll, { passive: true });
			start();
			cleanupCarousel = () => {
				stop();
				if (scrollResumeTimer !== null) {
					clearTimeout(scrollResumeTimer);
					scrollResumeTimer = null;
				}
				document.removeEventListener(
					"visibilitychange",
					handleVisibilityChange,
				);
				window.removeEventListener("scroll", handleScroll);
			};
		}

		function mount(mode) {
			if (mode !== "fullscreen") {
				stopCarousel();
				root.querySelectorAll("[data-carousel-item]").forEach((item) =>
					item.remove(),
				);
				root.querySelectorAll("#wallpaper-single-container > div").forEach(
					(wrapper) => wrapper.remove(),
				);
				root.style.display = "none";
				activeMode = mode;
				activeGroupKey = null;
				return;
			}

			const groupKey = getActiveGroupKey();
			if (activeMode === mode && activeGroupKey === groupKey) return;
			stopCarousel();
			root.style.display = "block";
			if (isCarouselEnabled) {
				root.querySelectorAll("[data-carousel-item]").forEach((item) =>
					item.remove(),
				);
				const activeGroup = root.querySelector(
					`[data-wallpaper-group="${groupKey}"]`,
				);
				activeGroup?.querySelectorAll("template[data-wallpaper-frame]").forEach(
					(template) => {
						activeGroup.appendChild(template.content.cloneNode(true));
					},
				);
				startCarousel(groupKey);
			} else {
				mountSingleImage(groupKey);
			}
			activeMode = mode;
			activeGroupKey = groupKey;
		}

		const handleModeChange = (event) => {
			mount(event.detail?.mode || getMode());
		};
		const handleViewportChange = () => {
			if (getMode() === "fullscreen") mount("fullscreen");
		};
		window.addEventListener("wallpaper-mode-change", handleModeChange);
		window.addEventListener("resize", handleViewportChange, { passive: true });
		mount(getMode());
	})();
</script>
