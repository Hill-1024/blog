---
import "./page-progress-bar.css";

interface Props {
	enable: boolean;
	height: number;
	duration: number;
}

const { enable, height, duration } = Astro.props;
---

{enable && (
	<>
		<div
			id="page-progress-bar"
			style={`--page-progress-bar-height: ${height}px; --page-progress-bar-duration: ${duration}ms;`}
		/>

		<script is:inline data-swup-ignore-script define:vars={{ enable }}>
			if (!enable) {
				const el = document.getElementById("page-progress-bar");
			if (el) {el.remove();}
			}

			let finishTimer = null;
			let doneTimer = null;
			let progressBarHooked = false;

			function clearProgressTimers() {
				if (finishTimer !== null) {
					clearTimeout(finishTimer);
					finishTimer = null;
				}
				if (doneTimer !== null) {
					clearTimeout(doneTimer);
					doneTimer = null;
				}
			}

			function setupProgressBar() {
				if (!window.swup || progressBarHooked) {return;}
				progressBarHooked = true;

				window.swup.hooks.on("visit:start", () => {
					clearProgressTimers();
					const bar = document.getElementById("page-progress-bar");
					if (bar) {
						bar.classList.remove("loading", "finishing", "done");
						requestAnimationFrame(() => {
							bar.classList.add("loading");
						});
					}
				});

				window.swup.hooks.on("visit:end", () => {
					clearProgressTimers();
					const bar = document.getElementById("page-progress-bar");
					if (bar) {
						bar.classList.remove("loading");
						bar.classList.add("finishing");
						finishTimer = setTimeout(() => {
							finishTimer = null;
							bar.classList.remove("finishing");
							bar.classList.add("done");
							doneTimer = setTimeout(() => {
								doneTimer = null;
								bar.classList.remove("done");
							}, 300);
						}, 200);
					}
				});
			}

			if (window.swup) {
				setupProgressBar();
			} else {
				document.addEventListener("swup:enable", setupProgressBar);
			}
		</script>
	</>
)}
