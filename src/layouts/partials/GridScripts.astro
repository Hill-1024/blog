---
/**
 * Grid Scripts - MainGridLayout 的内联脚本提取
 * 包含壁纸模式管理、布局切换和 Swup 集成逻辑
 */

interface Props {
	navbarTransparentMode?: string;
	defaultWallpaperMode?: string;
	defaultPostListLayout?: string;
	BANNER_HEIGHT?: number;
	pageScaling?: { enable: boolean; targetWidth?: number };
}

const {
	navbarTransparentMode = "semi",
	defaultWallpaperMode = "banner",
	defaultPostListLayout = "list",
	BANNER_HEIGHT = 35,
	pageScaling = { enable: false },
} = Astro.props;
---

<script
	type="module"
	is:inline
	data-swup-ignore-script
	define:vars={{
		navbarTransparentMode,
		defaultWallpaperMode,
		defaultPostListLayout,
		BANNER_HEIGHT,
		pageScaling,
	}}
>
	function syncLayoutShell(layout) {
		const mainGrid = document.getElementById("main-grid");
		const postListContainer = document.getElementById(
			"post-list-container",
		);
		const deviceGrid = document.querySelector("[data-device-grid]");
		const layoutContainer = postListContainer || deviceGrid;
		const effectiveLayout = layoutContainer ? layout : "list";
		const rightSidebar = document.querySelector(".right-sidebar-container");

		mainGrid?.setAttribute("data-layout-mode", effectiveLayout);
		rightSidebar?.classList.toggle(
			"hidden-in-grid-mode",
			Boolean(layoutContainer && effectiveLayout === "grid"),
		);

		return { mainGrid, postListContainer, effectiveLayout };
	}

	const WALLPAPER_MODE_TRANSITION_MS = 560;
	let activeWallpaperMode = null;
	let wallpaperModeTransitionTimer = null;
	let wallpaperModeTransitionGeneration = 0;

	function getWallpaperOpacity(wallpaper) {
		if (!wallpaper) {
			return "1";
		}

		const configuredOpacity = wallpaper.dataset.baseOpacity;
		if (configuredOpacity) {
			return configuredOpacity;
		}

		const inlineOpacity = wallpaper.style.opacity;
		const computedOpacity = getComputedStyle(wallpaper).opacity;
		const opacity = inlineOpacity || computedOpacity || "1";
		wallpaper.dataset.baseOpacity = opacity;
		return opacity;
	}

	function prepareWallpaperModeTransition({
		previousMode,
		nextMode,
		body,
		bannerWrapper,
		fullscreenWallpaper,
		mainContent,
		topRow,
		forceReflow,
		onComplete,
	}) {
		if (
			previousMode === null ||
			previousMode === nextMode ||
			window.matchMedia("(prefers-reduced-motion: reduce)").matches
		) {
			return null;
		}

		if (wallpaperModeTransitionTimer !== null) {
			window.clearTimeout(wallpaperModeTransitionTimer);
			wallpaperModeTransitionTimer = null;
		}
		const transitionGeneration = ++wallpaperModeTransitionGeneration;

		const bannerWasVisible =
			bannerWrapper && getComputedStyle(bannerWrapper).display !== "none";
		const currentBannerHeight = bannerWasVisible
			? Math.round(bannerWrapper.getBoundingClientRect().height)
			: 0;
		const targetBannerHeight =
			nextMode === "banner" && bannerWrapper
				? (() => {
						// Resolve the responsive custom property without forcing the
						// hidden Banner back into the document flow. This lets an
						// incoming hero keep its final wave edge while it fades in.
						const probe = document.createElement("div");
						probe.style.cssText =
							"position:absolute;visibility:hidden;pointer-events:none;height:var(--current-banner-height);";
						document.body.appendChild(probe);
						const height = Math.round(
							probe.getBoundingClientRect().height,
						);
						probe.remove();
						return height;
					})()
				: 0;
		const fullscreenWasVisible =
			fullscreenWallpaper &&
			getComputedStyle(fullscreenWallpaper).display !== "none";
		const fullscreenOpacity = getWallpaperOpacity(fullscreenWallpaper);
		const currentMainTop = mainContent
			? `${Math.round(mainContent.getBoundingClientRect().top)}px`
			: "0px";
		const currentMainMinHeight = mainContent
			? getComputedStyle(mainContent).minHeight
			: "0px";
		const currentTopRowHeight = topRow
			? `${Math.round(topRow.getBoundingClientRect().height)}px`
			: "0px";

		// Keep both visual layers mounted while the shell moves. The previous
		// implementation switched display immediately, which made the banner
		// height and the content anchor jump in the same frame.
		if (bannerWrapper) {
			bannerWrapper.style.display = "block";
		}
		if (
			fullscreenWallpaper &&
			(fullscreenWasVisible || nextMode === "fullscreen")
		) {
			fullscreenWallpaper.style.display = "block";
			if (nextMode === "fullscreen" && !fullscreenWasVisible) {
				fullscreenWallpaper.style.opacity = "0";
			}
		}

		body.style.setProperty(
			"--wallpaper-transition-banner-height",
			`${currentBannerHeight}px`,
		);
		body.style.setProperty(
			"--wallpaper-transition-banner-opacity",
			bannerWasVisible ? "1" : "0",
		);
		body.style.setProperty(
			"--wallpaper-transition-main-top",
			currentMainTop,
		);
		body.style.setProperty(
			"--wallpaper-transition-main-min-height",
			currentMainMinHeight,
		);
		body.style.setProperty(
			"--wallpaper-transition-top-row-height",
			currentTopRowHeight,
		);
		body.dataset.wallpaperTransitionTarget = nextMode;
		body.classList.add("wallpaper-mode-transition");
		forceReflow();

		// The caller applies the target body classes synchronously. Starting the
		// second leg on the next frame gives the browser real start values for
		// geometry/opacity instead of collapsing both states into one repaint.
		requestAnimationFrame(() => {
			if (transitionGeneration !== wallpaperModeTransitionGeneration) {
				return;
			}

			const mainTop =
				nextMode === "banner" &&
				mainContent?.classList.contains("mobile-main-no-banner") &&
				window.innerWidth < 1280
					? "5.5rem"
					: nextMode === "banner"
						? "var(--current-banner-height)"
						: "5.5rem";
			body.style.setProperty("--wallpaper-transition-main-top", mainTop);
			body.style.setProperty(
				"--wallpaper-transition-main-min-height",
				`calc(100vh - ${mainTop})`,
			);
			body.style.setProperty(
				"--wallpaper-transition-top-row-height",
				topRow?.classList.contains("content-top-row") ||
					nextMode !== "banner"
					? "4.5rem"
					: "calc(var(--current-banner-height) - 4.5rem)",
			);
			body.style.setProperty(
				"--wallpaper-transition-banner-height",
				nextMode === "banner"
					? `${targetBannerHeight}px`
					: `${currentBannerHeight}px`,
			);
			body.style.setProperty(
				"--wallpaper-transition-banner-opacity",
				nextMode === "banner" ? "1" : "0",
			);

			if (fullscreenWallpaper) {
				if (nextMode === "fullscreen") {
					fullscreenWallpaper.style.display = "block";
					fullscreenWallpaper.style.opacity = fullscreenOpacity;
				} else if (fullscreenWasVisible) {
					fullscreenWallpaper.style.opacity = "0";
				}
			}
		});

		wallpaperModeTransitionTimer = window.setTimeout(() => {
			if (transitionGeneration !== wallpaperModeTransitionGeneration) {
				return;
			}
			wallpaperModeTransitionGeneration += 1;

			body.classList.remove("wallpaper-mode-transition");
			delete body.dataset.wallpaperTransitionTarget;
			body.style.removeProperty("--wallpaper-transition-banner-height");
			body.style.removeProperty("--wallpaper-transition-banner-opacity");
			body.style.removeProperty("--wallpaper-transition-main-top");
			body.style.removeProperty("--wallpaper-transition-main-min-height");
			body.style.removeProperty("--wallpaper-transition-top-row-height");

			if (bannerWrapper) {
				if (nextMode === "banner") {
					bannerWrapper.style.display = "block";
				} else {
					bannerWrapper.style.display = "none";
				}
				bannerWrapper.style.removeProperty("height");
				bannerWrapper.style.removeProperty("opacity");
			}

			if (fullscreenWallpaper) {
				if (nextMode === "fullscreen") {
					fullscreenWallpaper.style.display = "block";
					fullscreenWallpaper.style.opacity = fullscreenOpacity;
				} else {
					fullscreenWallpaper.style.display = "none";
					fullscreenWallpaper.style.removeProperty("opacity");
				}
			}

			onComplete?.(nextMode);

			wallpaperModeTransitionTimer = null;
		}, WALLPAPER_MODE_TRANSITION_MS + 40);

		return true;
	}

	// 立即执行，在页面渲染前应用壁纸模式和布局模式，避免闪烁
	(function () {
		const wallpaperMode =
			localStorage.getItem("wallpaperMode") || defaultWallpaperMode;
		const body = document.body;
		activeWallpaperMode = wallpaperMode;

		// 立即应用 body 类，确保首次渲染就是正确的状态
		switch (wallpaperMode) {
			case "banner":
				body.classList.add("enable-banner");
				body.classList.remove(
					"wallpaper-transparent",
					"no-banner-mode",
				);
				break;
			case "fullscreen":
				body.classList.remove("enable-banner");
				body.classList.add("wallpaper-transparent", "no-banner-mode");
				break;
			case "none":
				body.classList.remove("enable-banner", "wallpaper-transparent");
				body.classList.add("no-banner-mode");
				break;
		}

		// 立即应用布局模式（正文位置完全由响应式 CSS 与 body 模式类控制）。
		// 使用 requestAnimationFrame 确保 DOM 准备好
		requestAnimationFrame(function () {
			// 立即应用布局模式，避免闪烁
			const mainGrid = document.getElementById("main-grid");
			if (mainGrid) {
				const savedLayout = localStorage.getItem("postListLayout");
				const currentLayout = savedLayout || defaultPostListLayout;
				const { postListContainer, effectiveLayout } =
					syncLayoutShell(currentLayout);
				if (postListContainer) {
					postListContainer.classList.remove(
						"list-mode",
						"grid-mode",
					);

					if (effectiveLayout === "grid") {
						postListContainer.classList.add("grid-mode");
						postListContainer.classList.add(
							"grid",
							"grid-cols-1",
							"lg:grid-cols-2",
							"gap-6",
						);
						postListContainer.classList.remove("flex", "flex-col");
					} else {
						postListContainer.classList.add("list-mode");
						postListContainer.classList.add("flex", "flex-col");
						postListContainer.classList.remove(
							"grid",
							"grid-cols-1",
							"lg:grid-cols-2",
							"gap-6",
						);
					}
				}
			}
		});
	})();

	// 根据壁纸模式动态设置 banner 和全屏壁纸的显示
	function applyWallpaperMode() {
		const wallpaperMode =
			localStorage.getItem("wallpaperMode") || defaultWallpaperMode;
		const previousWallpaperMode = activeWallpaperMode;
		activeWallpaperMode = wallpaperMode;
		const wallpaperModeTransitioning =
			wallpaperModeTransitionTimer !== null ||
			(previousWallpaperMode !== null &&
				previousWallpaperMode !== wallpaperMode &&
				!window.matchMedia("(prefers-reduced-motion: reduce)").matches);
		const bannerWrapper = document.getElementById("banner-wrapper");
		const fullscreenWallpaper = document.querySelector(
			"[data-fullscreen-wallpaper]",
		);
		const navbar = document.getElementById("navbar");
		const body = document.body;
		const mainContent = document.querySelector(
			".absolute.w-full.z-30.pointer-events-none",
		);
		const topRow = document.getElementById("top-row");
		const tocWrapper = document.getElementById("toc-wrapper");
		const syncTocVisibility = () => {
			if (!tocWrapper) {
				return;
			}

			const bannerHeight = bannerWrapper?.offsetHeight ?? 0;
			const shouldHideTOC =
				window.innerWidth >= 1280 &&
				bannerHeight > 0 &&
				window.scrollY <= bannerHeight;
			tocWrapper.classList.toggle("toc-hide", shouldHideTOC);
		};

		// 强制重排以确保样式正确应用
		const forceReflow = function () {
			void document.body.offsetHeight;
		};

		prepareWallpaperModeTransition({
			previousMode: previousWallpaperMode,
			nextMode: wallpaperMode,
			body,
			bannerWrapper,
			fullscreenWallpaper,
			mainContent,
			topRow,
			forceReflow,
			onComplete: (completedMode) => {
				if (completedMode === "banner") {
					syncTocVisibility();
				}
			},
		});

		switch (wallpaperMode) {
			case "banner":
				// 显示 banner，隐藏全屏壁纸
				if (bannerWrapper) {
					bannerWrapper.style.display = "block";
				}
				if (fullscreenWallpaper && !wallpaperModeTransitioning) {
					fullscreenWallpaper.style.display = "none";
				}
				// 先移除body类，避免CSS冲突
				body.classList.remove("wallpaper-transparent");
				body.classList.remove("no-banner-mode");
				// 动画基线已在 prepareWallpaperModeTransition 中建立，切换时
				// 不再插入同步重排，避免点击后出现一帧卡顿。
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				// 移除内联样式，让CSS完全接管
				if (mainContent) {
					mainContent.style.removeProperty("top");
				}
				// 再添加enable-banner类
				body.classList.add("enable-banner");
				// navbar 恢复原始透明模式（从 config 读取）
				if (navbar) {
					navbar.removeAttribute("data-dynamic-transparent");
					// 恢复 config 中设置的 data-transparent-mode
					navbar.setAttribute(
						"data-transparent-mode",
						navbarTransparentMode,
					);
					// 如果是 semifull 模式，重新初始化滚动检测
					if (
						navbarTransparentMode === "semifull" &&
						window.initSemifullScrollDetection
					) {
						window.initSemifullScrollDetection();
					}
				}
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				// 读取恢复后的真实 Banner 高度，避免从其他模式切回时
				// 因先前的 display:none 得到 0 并错误显示目录。
				if (!wallpaperModeTransitioning) {
					syncTocVisibility();
				}
				break;

			case "fullscreen":
				// 隐藏 banner，显示全屏壁纸
				if (bannerWrapper && !wallpaperModeTransitioning) {
					bannerWrapper.style.display = "none";
				}
				if (fullscreenWallpaper) {
					fullscreenWallpaper.style.display = "block";
				}
				// 在全屏模式下始终显示 TOC
				if (tocWrapper) {
					tocWrapper.classList.remove("toc-hide");
				}
				// 先移除body类，避免CSS冲突
				body.classList.remove("enable-banner");
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				// 移除内联样式，让CSS完全接管
				if (mainContent) {
					mainContent.style.removeProperty("top");
				}
				// 再添加wallpaper-transparent和no-banner-mode类
				body.classList.add("wallpaper-transparent");
				body.classList.add("no-banner-mode");
				// navbar 强制设置为 semi 透明模式（忽略 config 配置）
				if (navbar) {
					navbar.setAttribute("data-dynamic-transparent", "semi");
					// 强制移除 config 中的 data-transparent-mode 影响
					navbar.removeAttribute("data-transparent-mode");
				}
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				break;

			case "none":
				// 隐藏所有壁纸
				if (bannerWrapper && !wallpaperModeTransitioning) {
					bannerWrapper.style.display = "none";
				}
				if (fullscreenWallpaper && !wallpaperModeTransitioning) {
					fullscreenWallpaper.style.display = "none";
				}
				// 在无壁纸模式下也始终显示 TOC
				if (tocWrapper) {
					tocWrapper.classList.remove("toc-hide");
				}
				// 先移除body类，避免CSS冲突
				body.classList.remove("enable-banner");
				body.classList.remove("wallpaper-transparent");
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				// 移除内联样式，让CSS完全接管
				if (mainContent) {
					mainContent.style.removeProperty("top");
				}
				// 再添加no-banner-mode类
				body.classList.add("no-banner-mode");
				// navbar 强制设置为不透明（忽略 config 配置）
				if (navbar) {
					navbar.setAttribute("data-dynamic-transparent", "none");
					// 强制移除 config 中的 data-transparent-mode 影响
					navbar.removeAttribute("data-transparent-mode");
				}
				if (!wallpaperModeTransitioning) {
					forceReflow();
				}
				break;
		}
	}

	// 监听壁纸模式变化，立即应用（不重载页面）
	window.addEventListener("wallpaper-mode-change", function (_event) {
		applyWallpaperMode();
	});

	// 在 DOM 加载后执行
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", applyWallpaperMode);
	} else {
		applyWallpaperMode();
	}

	// 支持 Swup 页面过渡 - 在内容替换之前就应用布局，避免闪烁
	function setupSwupLayoutSync() {
		// @ts-ignore
		if (typeof window !== "undefined" && window.swup) {
			// 关键：在 content:replace 之前（animation:out:start）就准备好布局状态
			// @ts-ignore
			window.swup.hooks.on("animation:out:start", function () {
				// 保存当前布局状态，以便在新页面中立即应用
				const savedLayout = localStorage.getItem("postListLayout");
				if (savedLayout) {
					// @ts-ignore
					window.__pendingLayoutMode = savedLayout;
				}
			});

			// 在内容替换后立即应用布局，不等待其他脚本
			// @ts-ignore
			window.swup.hooks.on("content:replace", function () {
				const mainGrid = document.getElementById("main-grid");
				if (mainGrid) {
					// @ts-ignore
					const currentLayout =
						window.__pendingLayoutMode ||
						localStorage.getItem("postListLayout") ||
						defaultPostListLayout;
					const { postListContainer, effectiveLayout } =
						syncLayoutShell(currentLayout);
					if (postListContainer) {
						// 移除现有布局类
						postListContainer.classList.remove(
							"list-mode",
							"grid-mode",
						);

						if (effectiveLayout === "grid") {
							postListContainer.classList.add("grid-mode");
							postListContainer.classList.add(
								"grid",
								"grid-cols-1",
								"lg:grid-cols-2",
								"gap-6",
							);
							postListContainer.classList.remove(
								"flex",
								"flex-col",
							);
						} else {
							postListContainer.classList.add("list-mode");
							postListContainer.classList.add("flex", "flex-col");
							postListContainer.classList.remove(
								"grid",
								"grid-cols-1",
								"lg:grid-cols-2",
								"gap-6",
							);
						}
					}

					// 清除临时状态
					// @ts-ignore
					delete window.__pendingLayoutMode;
				}
			});

			return true;
		}
		return false;
	}

	// 尝试立即设置，如果失败则延迟重试
	if (!setupSwupLayoutSync()) {
		const checkSwup = setInterval(function () {
			if (setupSwupLayoutSync()) {
				clearInterval(checkSwup);
			}
		}, 50);

		setTimeout(function () {
			clearInterval(checkSwup);
		}, 2000);
	}

	// 支持 Swup 页面过渡
	document.addEventListener("swup:page:view", function () {
		applyWallpaperMode();

		// 在Swup页面切换时也要重新应用布局模式
		requestAnimationFrame(function () {
			const savedLayout = localStorage.getItem("postListLayout");
			const currentLayout = savedLayout || defaultPostListLayout;
			syncLayoutShell(currentLayout);
		});
	});

	// 在页面完全加载后，再次确认布局模式是否正确
	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", function () {
			const savedLayout = localStorage.getItem("postListLayout");
			const currentLayout = savedLayout || defaultPostListLayout;
			syncLayoutShell(currentLayout);
		});
	}
</script>
